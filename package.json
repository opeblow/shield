{
  "name": "shield-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Privacy-minded fraud scanning API and web app for suspicious messages.",
  "repository": { "type": "git", "url": "git+https://github.com/opeblow/shield.git" },
  "homepage": "https://github.com/opeblow/shield",
  "bugs": { "url": "https://github.com/opeblow/shield/issues" },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test dist/tests/foundation.test.js dist/tests/platform.test.js dist/tests/security.test.js tests/http-security.test.mjs tests/qr.test.mjs",
    "eval": "tsx eval/run.ts",
    "dev": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/server.js",
    "tenant:key": "node --env-file-if-exists=.env --import tsx scripts/create-tenant-key.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "integration": "node --test tests/integration/stack.test.mjs",
    "worker:scan": "node scripts/scan-worker.mjs",
    "migration:drill": "node scripts/migration-drill.mjs",
    "backup:restore": "node scripts/backup-restore.mjs",
    "chaos": "node scripts/chaos.mjs",
    "build": "tsc"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1",
    "@types/pg": "^8.15.5"
  },
  "dependencies": {
    "pg": "^8.16.0",
    "zod": "^4.0.5",
    "redis": "^5.6.1"
  }
}
